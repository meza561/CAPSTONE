{
  "name": "@sentropic/graphify",
  "version": "0.10.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "AI coding assistant skill (Claude Code, Codex, Gemini CLI, Kimi Code, GitHub Copilot CLI, Aider, OpenCode, OpenClaw) - turn any folder of code, docs, papers, images, or audio/video transcripts into a queryable knowledge graph",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "graphify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/skills"
  ],
  "scripts": {
    "build": "node scripts/gen-st-tokens.mjs && tsup && npm run build:studio",
    "build:graph": "npm --prefix packages/graph run build",
    "build:server": "node scripts/gen-st-tokens.mjs && tsup",
    "build:studio": "node scripts/build-studio-app.mjs",
    "bench:graph": "npm --prefix packages/graph run bench",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:graph": "npm --prefix packages/graph run test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:serve": "vitest run tests/serve.test.ts",
    "test:smoke": "./scripts/smoke-test.sh",
    "test:pipeline": "vitest run tests/pipeline.test.ts",
    "test:all": "vitest run && npm run test:smoke",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "gemini-cli",
    "kimi",
    "copilot",
    "copilot-cli",
    "aider",
    "opencode",
    "knowledge-graph",
    "rag",
    "graphrag",
    "obsidian",
    "community-detection",
    "tree-sitter",
    "louvain",
    "llm",
    "audio",
    "video",
    "whisper",
    "youtube",
    "ocr",
    "mistral-ocr",
    "pdf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/graphify.git"
  },
  "homepage": "https://github.com/rhanka/graphify",
  "bugs": {
    "url": "https://github.com/rhanka/graphify/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/cohere": "^3.0.34",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/mistral": "^3.0.35",
    "@ai-sdk/openai": "^3.0.61",
    "@sentropic/graph": "^0.1.0",
    "@sentropic/llm-mesh": "^0.1.0",
    "ai": "^6.0.175",
    "commander": "^14.0.3",
    "csv-parse": "^6.2.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-metrics": "^2.1.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-types": "^0.24.7",
    "mistral-ocr": "^0.1.0",
    "ollama-ai-provider": "^1.2.0",
    "web-tree-sitter": "^0.26.8",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^5.0.0",
    "neo4j-driver": "^6.0.1",
    "officeparser": "^7.0.2",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-lua": "^2.1.3",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "faster-whisper-ts": "^1.2.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-julia": "^0.23.1",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-objc": "^3.0.2",
    "tree-sitter-powershell": "^0.26.3",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-zig": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "faster-whisper-ts": {
      "optional": true
    },
    "tree-sitter-c-sharp": {
      "optional": true
    },
    "tree-sitter-elixir": {
      "optional": true
    },
    "tree-sitter-julia": {
      "optional": true
    },
    "tree-sitter-kotlin": {
      "optional": true
    },
    "tree-sitter-objc": {
      "optional": true
    },
    "tree-sitter-powershell": {
      "optional": true
    },
    "tree-sitter-scala": {
      "optional": true
    },
    "tree-sitter-swift": {
      "optional": true
    },
    "tree-sitter-zig": {
      "optional": true
    }
  },
  "overrides": {
    "officeparser": {
      "pdfjs-dist": "npm:empty-npm-package@1.0.0",
      "tesseract.js": "npm:empty-npm-package@1.0.0"
    },
    "tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "@sentropic/design-system-themes": "^0.10.3",
    "@sentropic/design-system-tokens": "^0.10.3"
  }
}
