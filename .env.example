# Environment for the heat simulation server. Copy to .env (or export these in
# the deployment environment) and adjust. Every value has a local-dev default,
# so ./start.sh works with none of them set.

# development | production
# production turns on forced HTTPS/HSTS and the /run rate limit; anything else
# leaves both off so http://localhost works.
FLASK_ENV=development

# Port the server binds. start.sh and run_ui_tests.sh both respect this.
PORT=5000

# Origin allowed to call the API cross-origin (/run, /frames, /study). The
# frontend is served from the same origin as the API, so this only matters if
# the UI is hosted separately.
ALLOWED_ORIGIN=http://localhost:5000

# Public base URL, used for the Open Graph image, the Twitter card and
# sitemap.xml. No trailing slash.
SITE_URL=http://localhost:5000

# Per-IP cap on POST /run, which spawns a solver process per request. Flask-
# Limiter syntax. The UI test suite makes ~19 runs, so a much lower cap will
# fail it when run repeatedly.
RUN_RATE_LIMIT=60 per minute
